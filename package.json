{
  "name": "jomla-go",
  "private": true,
  "version": "0.0.0",
  "description": "B2B distribution platform (white-label multi-tenant)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev & pnpm --filter @repo/api start:dev",
    "build": "pnpm --recursive --filter @repo/web build && pnpm --filter @repo/api build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
