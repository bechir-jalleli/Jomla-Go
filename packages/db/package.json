{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema and migrations for the platform",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate --custom",
    "db:migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:reset": "node --env-file=../../.env scripts/db-reset.js"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:"
  }
}
