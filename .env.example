# ──────────────────────────────────────────────────────────────
# Environment variable placeholders — copy to .env and fill in.
# NEVER commit real secrets. See AGENTS.md rule #9.
# ──────────────────────────────────────────────────────────────

# Application
NODE_ENV=development

# PostgreSQL (used by infra/docker-compose.dev.yml and packages/db)
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=jomla_dev

# Full connection URL (used by Drizzle and NestJS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://app_owner:change_me_in_env@localhost:5432/jomla_dev
