# Application
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_super_secret

# Role Passwords
POSTGRES_OWNER_PASSWORD=dev_owner_pass
POSTGRES_RUNTIME_PASSWORD=dev_runtime_pass
POSTGRES_PLATFORM_PASSWORD=dev_platform_pass

# Database config
POSTGRES_DB=jomla_dev

# Connection Strings
# Used by Drizzle for migrations
DATABASE_MIGRATOR_URL=postgresql://app_owner:CHANGE_ME_OWNER@localhost:5433/jomla_dev
# Used by the API at runtime (tenant-scoped)
DATABASE_URL=postgresql://app_runtime:CHANGE_ME_RUNTIME@localhost:5433/jomla_dev
# Used by the API for platform operations (tenancy, auth, jobs)
DATABASE_PLATFORM_URL=postgresql://app_platform:CHANGE_ME_PLATFORM@localhost:5433/jomla_dev
# Used by integration tests (Vitest)
DATABASE_TEST_URL=postgresql://app_runtime:CHANGE_ME_RUNTIME@localhost:5433/jomla_dev
